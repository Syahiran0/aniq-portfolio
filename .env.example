# Copy this file to .env and fill it in. .env is gitignored; this example file is safe to commit.

# The password you type on the dashboard login screen (/#/admin).
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Signs the login cookie. Use 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
